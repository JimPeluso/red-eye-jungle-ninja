{
  "name": "red-eye-jungle-ninja",
  "private": true,
  "description": "Red Eye the jungle ninja: a browser platformer built with a young game designer.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "npm ci && playwright install chromium webkit",
    "test": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "serve": "python3 -m http.server 8000 --bind 0.0.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "eslint": "10.15.0",
    "espree": "11.2.0",
    "globals": "17.14.0",
    "prettier": "3.10.1"
  }
}
